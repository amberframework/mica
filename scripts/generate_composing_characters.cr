# Generates src/mica/xml/composing_characters.cr from the Unicode data built
# into the Crystal standard library:
#
#   crystal-alpha run scripts/generate_composing_characters.cr > src/mica/xml/composing_characters.cr
#
# A composing character (W3C Character Model, used by XML 1.1 section 2.13)
# is one with a non-zero canonical combining class, or the second character
# of the canonical decomposition of a primary composite.
#
# The combining class is not public in stdlib, so it is read through
# canonical ordering: in NFD, U+0345 (class 240) moves after any following
# character of class 1 to 239, and U+0334 (class 1) moves before any
# preceding character of class 2 to 255.
YPOGEGRAMMENI = '\u{0345}'
TILDE_OVERLAY = '\u{0334}'

# Characters with class 0 whose decomposition starts with a non-zero class.
CLASS_ZERO_DECOMPOSABLE = {0x0F73, 0x0F75, 0x0F81}

def nonzero_class?(char : Char) : Bool
  decomposed = char.to_s.unicode_normalize(:nfd)
  first = decomposed[0]
  return false if decomposed.size > 1 && CLASS_ZERO_DECOMPOSABLE.includes?(char.ord)
  low = "#{YPOGEGRAMMENI}#{first}".unicode_normalize(:nfd)
  return true if low.starts_with?(first)
  high = "#{first}#{TILDE_OVERLAY}".unicode_normalize(:nfd)
  high.starts_with?(TILDE_OVERLAY)
end

composing = Set(Int32).new
(0..0x10FFFF).each do |code|
  next if code >= 0xD800 && code <= 0xDFFF
  char = code.unsafe_chr
  composing << code if nonzero_class?(char)
  decomposed = char.to_s.unicode_normalize(:nfd)
  next unless decomposed.size >= 2
  next unless decomposed.unicode_normalize(:nfc) == char.to_s
  composing << decomposed[-1].ord
end

ranges = [] of {Int32, Int32}
composing.to_a.sort!.each do |code|
  last = ranges.last?
  if last && last[1] + 1 == code
    ranges[-1] = {last[0], code}
  else
    ranges << {code, code}
  end
end

puts "# Generated by scripts/generate_composing_characters.cr from the Unicode"
puts "# #{Unicode::VERSION} data in the Crystal standard library. Do not edit."
puts "module Mica::XML"
puts "  # :nodoc:"
puts "  #"
puts "  # Code point ranges (inclusive) of the composing characters: non-zero"
puts "  # canonical combining class, or the second character of a primary"
puts "  # composite's canonical decomposition."
puts "  module ComposingCharacters"
puts "    RANGES = StaticArray["
ranges.each_slice(4) do |slice|
  puts "      " + slice.map { |(first, last)| "{0x#{first.to_s(16).upcase}, 0x#{last.to_s(16).upcase}}" }.join(", ") + ","
end
puts "    ]"
puts ""
puts "    # Returns true when *code* is a composing character."
puts "    def self.includes?(code : Int32) : Bool"
puts "      low = 0"
puts "      high = RANGES.size - 1"
puts "      while low <= high"
puts "        middle = (low + high) // 2"
puts "        first, last = RANGES[middle]"
puts "        if code < first"
puts "          high = middle - 1"
puts "        elsif code > last"
puts "          low = middle + 1"
puts "        else"
puts "          return true"
puts "        end"
puts "      end"
puts "      false"
puts "    end"
puts "  end"
puts "end"
